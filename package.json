{
	"name": "sound-garden",
	"version": "4.0.0",
	"private": true,
	"type": "module",
	"description": "Sound Garden: sound-first phonics practice for kindergarten learners and the grown-ups who help them.",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run test:unit && npm run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test --trace off",
		"catalog:migrate": "node scripts/build-catalog.mjs",
		"prepare": "svelte-kit sync || echo \"\""
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "~3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.3.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@fontsource/andika": "^5.2.0",
		"idb-keyval": "^6.2.2"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
